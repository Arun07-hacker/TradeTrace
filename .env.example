# ==============================================================================
# TradeTrace Configuration Template
# Tagline: Research -> Challenge -> Decide -> Monitor -> Trace -> Learn
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
DEMO_MODE=True
APP_NAME=TradeTrace
API_V1_STR=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Authentication & Security
# Generate a strong 32+ char secret in production (e.g. openssl rand -hex 32)
JWT_SECRET=tradetrace-super-secure-dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL + pgvector Database
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tradetrace
# Synchronous DB URL for Alembic migrations and sync scripts:
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/tradetrace

# LLM Provider Abstraction
# Supported: "mock", "openai", "anthropic", "gemini"
LLM_PROVIDER=mock
LLM_API_KEY=mock-dev-key
LLM_MODEL=mock-trading-intelligence-v1
LLM_BASE_URL=
LLM_TEMPERATURE=0.2

# Market Data Provider Abstraction
# Supported: "mock", "polygon", "alphavantage", "yfinance"
MARKET_DATA_PROVIDER=mock
MARKET_DATA_API_KEY=mock-market-key

# Financial News Provider Abstraction
# Supported: "mock", "finnhub", "newsapi"
NEWS_PROVIDER=mock
NEWS_API_KEY=mock-news-key

# Paper Trading & Risk Defaults
INITIAL_PAPER_BALANCE=100000.0
DEFAULT_RISK_PER_TRADE_PCT=1.0
MAX_PORTFOLIO_EXPOSURE_PCT=50.0

# Monitoring Worker
MONITORING_INTERVAL_SECONDS=60
